# Step 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app
RUN npm i -g pnpm@10
# pnpm-workspace.yaml carries the security overrides; the lockfile must match it
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Step 2: Build
FROM deps AS build
COPY . .
ARG CACHE_BUST
ARG VITE_BASE_URL
ARG VITE_TINY_API_KEY
# The build fails (vite.config.ts) when VITE_BASE_URL is empty
ENV VITE_BASE_URL=$VITE_BASE_URL \
    VITE_TINY_API_KEY=$VITE_TINY_API_KEY
RUN echo "Cache bust: ${CACHE_BUST:-0}"
RUN pnpm build

# Step 3: Production image
FROM node:20-alpine AS prod
WORKDIR /app
RUN npm i -g pnpm@10
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile

# Copy the build folder instead of dist
COPY --from=build /app/build /app/build

WORKDIR /app

# Expose the application port
EXPOSE 5000

# Start command (for React Router SSR production server)
CMD ["pnpm", "start"]